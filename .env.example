# ========================================================================
# AI INTERVIEW ASSESSMENT PLATFORM - ENVIRONMENT TEMPLATE (.env.example)
# Multimodal Deep Learning & Computer Vision Platform
# ========================================================================

APP_ENV=production
SECRET_KEY=ai_interview_assessment_super_secret_key_2026

# ========================================================================
# 1. DATABASE CONFIGURATION (PostgreSQL Primary)
# ========================================================================
# PostgreSQL URI (Recommended for Production and Cloud Deployments)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/interview_db

# Fallback / Alternative Database URIs (if PostgreSQL is not running locally):
# DATABASE_URL=mysql+pymysql://root:root@localhost:3306/interview_db
# DATABASE_URL=sqlite:///backend/interview_db.sqlite

# ========================================================================
# 2. SUPABASE OBJECT STORAGE CONFIGURATION
# ========================================================================
# Supabase Storage provides secure, high-performance S3/REST cloud storage.
# Used for candidate resumes, registration photos, interview videos, snapshots, and reports.
# Find your Project URL and Service Role Key in:
# Supabase Dashboard -> Project Settings -> API -> Project URL & Project API Keys (service_role)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=ai-interview

# ========================================================================
# 3. REAL-TIME EMAIL DELIVERY VIA SMTP (GMAIL, OUTLOOK, YAHOO, UNIVERSITY)
# ========================================================================
# HOW TO GET A GMAIL 16-CHARACTER APP PASSWORD:
# 1. Sign in to your Google Account (https://myaccount.google.com).
# 2. Go to 'Security' -> ensure '2-Step Verification' is turned ON.
# 3. Under '2-Step Verification', scroll to bottom & click 'App passwords'.
#    Direct Link: https://myaccount.google.com/apppasswords
# 4. Enter App name (e.g., "AI Interview Platform") and click 'Create'.
# 5. Copy the generated 16-character password (e.g., 'abcd efgh ijkl mnop').
# 6. Paste it below into MAIL_PASSWORD (spaces are automatically handled).
#
# OTHER MAJOR EMAIL PROVIDERS:
# - Microsoft Outlook/Office365:
#     MAIL_SERVER=smtp.office365.com, MAIL_PORT=587, MAIL_USE_TLS=true, MAIL_USE_SSL=false
# - Yahoo Mail:
#     MAIL_SERVER=smtp.mail.yahoo.com, MAIL_PORT=587, MAIL_USE_TLS=true (Requires Yahoo App Password)
# - Custom / University / Corporate Domains (e.g., @mwu.edu.np, @company.com):
#     MAIL_SERVER=mail.yourdomain.edu, MAIL_PORT=587 (TLS) or 465 (SSL)
# ========================================================================

EMAIL_PROVIDER=smtp
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_actual_gmail@gmail.com
MAIL_PASSWORD=your_16_digit_app_password
MAIL_DEFAULT_SENDER="AI Interview Assessment System <your_actual_gmail@gmail.com>"
MAIL_TIMEOUT=12
MAIL_AUTO_FALLBACK=true

# ========================================================================
# 4. ALTERNATIVE: RESEND API (HTTP REST DISPATCH)
# ========================================================================
# Free API key at https://resend.com
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM=AI Interview <onboarding@resend.dev>

# ========================================================================
# 5. OTP & VERIFICATION POLICIES
# ========================================================================
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Email Verification Link Policies
APP_BASE_URL=http://localhost:5000
VERIFICATION_LINK_EXPIRE_MINUTES=15
